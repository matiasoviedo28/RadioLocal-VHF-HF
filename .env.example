# Variables de entorno de RadioLocal-VHF-HF.
# Copiar a ".env" y ajustar según el entorno. Prefijo RADIOLOCAL_.

# Entorno de ejecución: dev | prod
RADIOLOCAL_ENV=dev

# Versión de la aplicación (normalmente se deja el valor por defecto del código).
# RADIOLOCAL_APP_VERSION=0.1.0

# --- Fase 1: relieve / terreno ---
# API key GRATUITA de OpenTopography. Obtenela así:
#   1. Registrate en https://portal.opentopography.org/newUser
#   2. En tu perfil (myopentopo) -> "Request an API Key".
#   3. Pegá la clave acá. NUNCA la commitees (este archivo es .example; el real
#      es .env, que está en .gitignore).
OPENTOPOGRAPHY_API_KEY=

# Opcionales (tienen valor por defecto en el código):
# RADIOLOCAL_DEM_DEMTYPE=COP30                 # Copernicus GLO-30 (30 m)
# RADIOLOCAL_DEM_MAX_TILES_PER_REQUEST=12      # tope por 'prepare'

# --- Fases futuras ---
# RADIOLOCAL_DATABASE_URL=postgresql://usuario:clave@db:5432/radiolocal   # Fase 3
